#include <windows.h>
#include "ctrls.h"

IDD_CTRLS DIALOG 10, 10, 250, 170
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_VISIBLE
CAPTION "Controls"
FONT 8, "Helv"
BEGIN
    LTEXT "&Text:", -1, 8, 8, 30, 10
    EDITTEXT IDC_EDIT, 40, 6, 90, 12, ES_AUTOHSCROLL
    LTEXT "&Memo:", -1, 8, 24, 30, 10
    EDITTEXT IDC_MEMO, 40, 22, 90, 40, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
    LISTBOX IDC_LIST, 140, 6, 100, 56, LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    COMBOBOX IDC_COMBO, 140, 68, 100, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX "Options", -1, 8, 68, 122, 52
    CONTROL "&Check me", IDC_CHECK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 80, 100, 10
    CONTROL "Radio &one", IDC_RADIO1, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 14, 92, 100, 10
    CONTROL "Radio &two", IDC_RADIO2, "Button", BS_AUTORADIOBUTTON, 14, 104, 100, 10
    SCROLLBAR IDC_SCROLL, 140, 88, 100, 10
    LTEXT "0", IDC_POS, 140, 102, 40, 10
    DEFPUSHBUTTON "OK", IDOK, 60, 140, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 140, 140, 50, 14
END
