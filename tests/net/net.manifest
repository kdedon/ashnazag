# Network additions to the test root: the tape's inet configuration and
# tools.  @CORE@ = tape segment 02 (the RAM-disk build/core),
# @NET07@ = segment 07 (getnet.sh).  Device nodes come from root.manifest.
d /usr/sbin	755 2 2
d /usr/amiga	755 2 2
d /usr/amiga/bin 755 2 2
d /etc/inet	755 0 3
f /usr/lib/libsocket.so	755 2 2 @CORE@/usr/lib/libsocket.so
f /usr/lib/libnsl.so	755 2 2 @CORE@/usr/lib/libnsl.so
f /usr/lib/tcpip.so	755 2 2 @CORE@/usr/lib/tcpip.so
f /usr/lib/straddr.so	755 2 2 @CORE@/usr/lib/straddr.so
f /usr/sbin/slink	500 0 3 @CORE@/usr/sbin/slink
f /usr/sbin/ifconfig	4555 0 3 @CORE@/usr/sbin/ifconfig
f /usr/amiga/bin/aen	555 2 2 @CORE@/usr/amiga/bin/aen
f /usr/sbin/ping	4555 0 3 @NET07@/usr/sbin/ping
f /usr/sbin/route	555 2 2 @NET07@/usr/sbin/route
f /usr/sbin/arp		2555 2 3 @NET07@/usr/sbin/arp
f /usr/bin/netstat	4555 0 3 @NET07@/usr/bin/netstat
f /etc/inet/strcf	444 0 3 @CORE@/etc/inet/strcf
l /etc/strcf		/etc/inet/strcf
f /etc/inet/hosts	444 0 3 @CORE@/etc/inet/hosts
l /etc/hosts		/etc/inet/hosts
f /etc/inet/protocols	444 0 3 @CORE@/etc/inet/protocols
l /etc/protocols	/etc/inet/protocols
f /etc/inet/services	444 0 3 @CORE@/etc/inet/services
l /etc/services		/etc/inet/services
f /etc/netconfig	444 0 3 @CORE@/etc/netconfig
