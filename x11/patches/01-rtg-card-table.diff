+/*
+** zz9000card.c - the ZZ9000 entry of the RTG card table.
+**
+** 16-bit TrueColor RGB565 with the AMIX screen device for input.
+*/
+
+#include "../../amix.h"
+#include "servermd.h"
+#include "resource.h"
+#include "zz9000.h"
+
+extern fbFd amixFbs[];
+
+/* TrueColor 16-bit visual for RGB565, filled in each generation */
+static VisualRec zzVisual;
+static VisualID  zzVID;
+static DepthRec  zzDepth;
+static unsigned long zzGeneration = 0;
+
+static Bool
+zzProbe(index)
+int index;
+{
+    if (!ZZ9000Probe())
+    {
+        ErrorF("rtgProbe: RTG card not found at %s\n", ZZ9000_DEV);
+        return FALSE;
+    }
+    amixFbs[index].bp.width  = ZZ9000_selected_mode->w;
+    amixFbs[index].bp.height = ZZ9000_selected_mode->h;
+    return TRUE;
+}
+
+static Bool
+zzCreate(pScreenInfo, index)
+ScreenInfo *pScreenInfo;
+int         index;
+{
+    if (zzGeneration != serverGeneration)
+    {
+        zzVisual.vid            = FakeClientID(0);
+        zzVisual.class          = TrueColor;
+        zzVisual.bitsPerRGBValue = 8;
+        zzVisual.ColormapEntries = 64;   /* 2^6 - green channel dominates */
+        zzVisual.nplanes        = ZZ9000_DEPTH;
+        zzVisual.redMask        = ZZ9000_RED_MASK;
+        zzVisual.greenMask      = ZZ9000_GREEN_MASK;
+        zzVisual.blueMask       = ZZ9000_BLUE_MASK;
+        zzVisual.offsetRed      = ZZ9000_RED_SHIFT;
+        zzVisual.offsetGreen    = ZZ9000_GREEN_SHIFT;
+        zzVisual.offsetBlue     = ZZ9000_BLUE_SHIFT;
+
+        zzVID             = zzVisual.vid;
+        zzDepth.depth     = ZZ9000_DEPTH;
+        zzDepth.numVids   = 1;
+        zzDepth.vids      = &zzVID;
+
+        zzGeneration = serverGeneration;
+    }
+
+    pScreenInfo->numPixmapFormats = 2;
+
+    pScreenInfo->formats[0].depth        = ZZ9000_DEPTH;
+    pScreenInfo->formats[0].bitsPerPixel = ZZ9000_BPP;
+    pScreenInfo->formats[0].scanlinePad  = BITMAP_SCANLINE_PAD;
+
+    pScreenInfo->formats[1].depth        = 1;
+    pScreenInfo->formats[1].bitsPerPixel = 1;
+    pScreenInfo->formats[1].scanlinePad  = BITMAP_SCANLINE_PAD;
+    return TRUE;
+}
+
+static Bool
+zzInitHW(pRTG, index)
+rtgScreenPtr pRTG;
+int          index;
+{
+    pRTG->width        = ZZ9000_selected_mode->w;
+    pRTG->height       = ZZ9000_selected_mode->h;
+    pRTG->pitch        = ZZ9000_selected_mode->w * 2;
+    pRTG->bitsPerPixel = ZZ9000_BPP;
+    pRTG->depth        = ZZ9000_DEPTH;
+    pRTG->fbOffset     = ZZ9000_FB_OFFSET;
+    return ZZ9000InitHW(pRTG);
+}
