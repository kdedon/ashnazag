+/* no password needed: a local display, and login's PASSREQ isn't YES */
+static int
+EmptyOK (d)
+struct display	*d;
+{
+	FILE	*f;
+	char	line[128];
+	int	ok = d->displayType.location == Local;
+
+	if (ok && (f = fopen ("/etc/default/login", "r"))) {
+		while (fgets (line, sizeof line, f))
+			if (!strncmp (line, "PASSREQ=YES", 11))
+				ok = 0;
+		fclose (f);
+	}
+	return ok;
+}
