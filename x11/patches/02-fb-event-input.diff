diff -urN xc/programs/Xserver/hw/amix/amix.h ../full/xc/programs/Xserver/hw/amix/amix.h
--- a/programs/Xserver/hw/amix/amix.h	2026-09-29 21:18:21.984610243 -0500
+++ b/programs/Xserver/hw/amix/amix.h	2026-09-29 23:03:07.943099480 -0500
@@ -128,6 +128,24 @@
     void		(*EnterLeave)();    /* screen switch */
 } fbFd;
 
+/*
+ * Keyboard and mouse read from devices other than the AMIX screen device.
+ * When amixInput is set, the keyboard's DEVICE_ON/OFF and the wakeup
+ * handler call it instead of using amixFbs[].fd.
+ */
+typedef struct _amixInputOps {
+    void	(*enable)();		/* () */
+    void	(*disable)();		/* () */
+    void	(*read)();		/* (pReadmask) */
+} amixInputOpsRec, *amixInputOpsPtr;
+
+extern amixInputOpsPtr amixInput;
+
+/* Keymap in use; X keycode = (raw code & 0x7F) + amixKeyOffset */
+extern KeySymsPtr amixKeySymsPtr;
+extern CARD8	  *amixModMapPtr;
+extern int	  amixKeyOffset;
+
 extern Bool amixSupportsDepth8;
 extern unsigned long amixGeneration;
 
diff -urN xc/programs/Xserver/hw/amix/amixKbd.c ../full/xc/programs/Xserver/hw/amix/amixKbd.c
