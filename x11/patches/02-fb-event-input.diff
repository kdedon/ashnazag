+++ b/programs/Xserver/hw/amix/amixKbd.c	2026-09-29 23:03:07.944099478 -0500
@@ -74,6 +74,11 @@
 static KeybdCtrl  sysKbCtrl;
 void amixFindInputScreen();
 
+amixInputOpsPtr	amixInput;
+KeySymsPtr	amixKeySymsPtr = &amixKeySyms;
+CARD8		*amixModMapPtr = amixModMap;
+int		amixKeyOffset = 1;
+
 KbPrivRec  	sysKbPriv = {
     0,				/* Fd for current device */
     amixKbdGetEvents,		/* Function to read events */
@@ -134,13 +139,16 @@
 #endif
 	    InitKeyboardDeviceStruct(
 		    pKeyboard,
-		    &amixKeySyms,
-		    amixModMap,
+		    amixKeySymsPtr,
+		    amixModMapPtr,
 		    amixBell,
 		    amixKbdCtrl);
 	    break;
 
 	case DEVICE_ON:
+	    if (amixInput)
+		(*amixInput->enable)();
+	    else
 	    {
 		int i;
 
@@ -155,6 +163,9 @@
 
 	case DEVICE_CLOSE:
 	case DEVICE_OFF:
+	    if (amixInput)
+		(*amixInput->disable)();
+	    else
 	    {
 		int i;
 
@@ -289,7 +300,7 @@
     CARD8		keyModifiers;
     Bool		keydown;
 
-    key = (fe->code & 0x7F) + 1;
+    key = (fe->code & 0x7F) + amixKeyOffset;
     keydown = (fe->code> 0x7F) ? FALSE : TRUE;
 
     keyModifiers = ((DeviceIntPtr)pKeyboard)->key->modifierMap[key];
@@ -400,7 +411,10 @@
 
     if (pKbdCtrl->autoRepeat != AutoRepeatModeOn)
     {
-	amixFindInputScreen(nscreen, pbdata, err, (fd_set *)pReadmask);
+	if (amixInput)
+	    (*amixInput->read)(pReadmask);
+	else
+	    amixFindInputScreen(nscreen, pbdata, err, (fd_set *)pReadmask);
 	return;
     }
 
@@ -421,7 +435,10 @@
 	autoRepeatReady = 0;
     }
 
-    amixFindInputScreen(nscreen, pbdata, err, (fd_set *)pReadmask);
+    if (amixInput)
+	(*amixInput->read)(pReadmask);
+    else
+	amixFindInputScreen(nscreen, pbdata, err, (fd_set *)pReadmask);
 }
 
