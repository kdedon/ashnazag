+#ifdef __m68k__
+/* Transform of 3-component positions by a general matrix, clip test and
+ * perspective divide in one pass: the results of TransformRaw followed by
+ * _mesa_clip_tab[4].
+ */
+static void transform_cliptest3( const GLfloat m[16],
+				 const GLvector4f *from_vec,
+				 GLvector4f *clip_vec,
+				 GLvector4f *proj_vec,
+				 GLubyte clipMask[],
+				 GLubyte *orMask,
+				 GLubyte *andMask )
+{
+   const GLuint stride = from_vec->stride;
+   const GLfloat *from = from_vec->start;
+   GLfloat (*to)[4] = (GLfloat (*)[4])clip_vec->start;
+   GLfloat (*vProj)[4] = (GLfloat (*)[4])proj_vec->start;
+   const GLuint count = from_vec->count;
+   GLubyte tmpAndMask = *andMask, tmpOrMask = *orMask;
+   GLuint i, c = 0;
+
+   for (i = 0; i < count; i++, STRIDE_F(from, stride)) {
+      const GLfloat ox = from[0], oy = from[1], oz = from[2];
+      const GLfloat cx = m[0] * ox + m[4] * oy + m[8]  * oz + m[12];
+      const GLfloat cy = m[1] * ox + m[5] * oy + m[9]  * oz + m[13];
+      const GLfloat cz = m[2] * ox + m[6] * oy + m[10] * oz + m[14];
+      const GLfloat cw = m[3] * ox + m[7] * oy + m[11] * oz + m[15];
+      const GLfloat nw = -cw;
+      GLubyte mask = 0;
+
+      to[i][0] = cx;
+      to[i][1] = cy;
+      to[i][2] = cz;
+      to[i][3] = cw;
+      if (cx > cw) mask |= CLIP_RIGHT_BIT;
+      if (cx < nw) mask |= CLIP_LEFT_BIT;
+      if (cy > cw) mask |= CLIP_TOP_BIT;
+      if (cy < nw) mask |= CLIP_BOTTOM_BIT;
+      if (cz > cw) mask |= CLIP_FAR_BIT;
+      if (cz < nw) mask |= CLIP_NEAR_BIT;
+      clipMask[i] = mask;
+      if (mask) {
+	 c++;
+	 tmpAndMask &= mask;
+	 tmpOrMask |= mask;
+	 vProj[i][0] = 0;
+	 vProj[i][1] = 0;
+	 vProj[i][2] = 0;
+	 vProj[i][3] = 1;
+      } else {
+	 const GLfloat oow = 1.0F / cw;
+	 vProj[i][0] = cx * oow;
+	 vProj[i][1] = cy * oow;
+	 vProj[i][2] = cz * oow;
+	 vProj[i][3] = oow;
+      }
+   }
+
+   *orMask = tmpOrMask;
+   *andMask = (GLubyte) (c < count ? 0 : tmpAndMask);
+   clip_vec->size = 4;
+   clip_vec->flags |= VEC_SIZE_4;
+   clip_vec->count = count;
+   proj_vec->size = 4;
+   proj_vec->flags |= VEC_SIZE_4;
+   proj_vec->count = count;
+}
+#endif
