 /*
+ * Smooth- and flat-shaded triangles without depth test, RGBA color.
+ */
+static void smooth_rgba_triangle( GLcontext *ctx, const SWvertex *v0,
+                                  const SWvertex *v1, const SWvertex *v2 )
+{
+   const OSMesaContext osmesa = OSMESA_CONTEXT(ctx);
+#define INTERP_RGB 1
+#define INTERP_ALPHA 1
+#define RENDER_SPAN( span )					\
+   GLuint i;							\
+   GLchan *img = PIXELADDR4(span.x, span.y); 			\
+   for (i = 0; i < span.end; i++, img += 4) {			\
+      PACK_RGBA(img, FixedToChan(span.red),			\
+         FixedToChan(span.green), FixedToChan(span.blue),	\
+         FixedToChan(span.alpha));				\
+      span.red += span.redStep;					\
+      span.green += span.greenStep;				\
+      span.blue += span.blueStep;				\
+      span.alpha += span.alphaStep;				\
+   }
+#include "swrast/s_tritemp.h"
+}
+
+static void flat_rgba_triangle( GLcontext *ctx, const SWvertex *v0,
+                                const SWvertex *v1, const SWvertex *v2 )
+{
+   const OSMesaContext osmesa = OSMESA_CONTEXT(ctx);
+#define SETUP_CODE						\
+   GLuint pixel;						\
+   PACK_RGBA((GLchan *) &pixel, v2->color[0], v2->color[1],	\
+                                v2->color[2], v2->color[3]);
+#define RENDER_SPAN( span )				\
+   GLuint i;						\
+   GLuint *img = (GLuint *) PIXELADDR4(span.x, span.y);	\
+   for (i = 0; i < span.end; i++)			\
+      img[i] = pixel;
+#include "swrast/s_tritemp.h"
+}
+
+
+/*
+ * The same four for RGB 565.
+ */
+static void smooth_565_z_triangle( GLcontext *ctx, const SWvertex *v0,
+                                   const SWvertex *v1, const SWvertex *v2 )
+{
+   const OSMesaContext osmesa = OSMESA_CONTEXT(ctx);
+#define INTERP_Z 1
+#define DEPTH_TYPE DEFAULT_SOFTWARE_DEPTH_TYPE
+#define INTERP_RGB 1
+#define RENDER_SPAN( span )					\
+   GLuint i;							\
+   GLushort *img = (GLushort *) PIXELADDR2(span.x, span.y);	\
+   for (i = 0; i < span.end; i++) {				\
+      const GLdepth z = FixedToDepth(span.z);			\
+      if (z < zRow[i]) {					\
+         PACK_RGB_565(img[i], FixedToChan(span.red),		\
+            FixedToChan(span.green), FixedToChan(span.blue));	\
+         zRow[i] = z;						\
+      }								\
+      span.red += span.redStep;					\
+      span.green += span.greenStep;				\
+      span.blue += span.blueStep;				\
+      span.z += span.zStep;					\
+   }
+#include "swrast/s_tritemp.h"
+}
+
+static void flat_565_z_triangle( GLcontext *ctx, const SWvertex *v0,
+                                 const SWvertex *v1, const SWvertex *v2 )
+{
+   const OSMesaContext osmesa = OSMESA_CONTEXT(ctx);
+#define INTERP_Z 1
+#define DEPTH_TYPE DEFAULT_SOFTWARE_DEPTH_TYPE
+#define SETUP_CODE						\
+   GLushort pixel;						\
+   PACK_RGB_565(pixel, v2->color[0], v2->color[1], v2->color[2]);
+#define RENDER_SPAN( span )					\
+   GLuint i;							\
+   GLushort *img = (GLushort *) PIXELADDR2(span.x, span.y);	\
+   for (i = 0; i < span.end; i++) {				\
+      const GLdepth z = FixedToDepth(span.z);			\
+      if (z < zRow[i]) {					\
+         img[i] = pixel;					\
+         zRow[i] = z;						\
+      }								\
+      span.z += span.zStep;					\
+   }
+#include "swrast/s_tritemp.h"
+}
+
+static void smooth_565_triangle( GLcontext *ctx, const SWvertex *v0,
+                                 const SWvertex *v1, const SWvertex *v2 )
+{
+   const OSMesaContext osmesa = OSMESA_CONTEXT(ctx);
+#define INTERP_RGB 1
+#define RENDER_SPAN( span )					\
+   GLuint i;							\
+   GLushort *img = (GLushort *) PIXELADDR2(span.x, span.y);	\
+   for (i = 0; i < span.end; i++) {				\
+      PACK_RGB_565(img[i], FixedToChan(span.red),		\
+         FixedToChan(span.green), FixedToChan(span.blue));	\
+      span.red += span.redStep;					\
+      span.green += span.greenStep;				\
+      span.blue += span.blueStep;				\
+   }
+#include "swrast/s_tritemp.h"
+}
+
+static void flat_565_triangle( GLcontext *ctx, const SWvertex *v0,
+                               const SWvertex *v1, const SWvertex *v2 )
+{
+   const OSMesaContext osmesa = OSMESA_CONTEXT(ctx);
+#define SETUP_CODE						\
+   GLushort pixel;						\
+   PACK_RGB_565(pixel, v2->color[0], v2->color[1], v2->color[2]);
+#define RENDER_SPAN( span )					\
+   GLuint i;							\
+   GLushort *img = (GLushort *) PIXELADDR2(span.x, span.y);	\
+   for (i = 0; i < span.end; i++)				\
+      img[i] = pixel;
+#include "swrast/s_tritemp.h"
+}
+
