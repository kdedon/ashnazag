+/* A primitive with no clipped vertex goes whole to the driver. */
+static GLboolean unclipped( GLcontext *ctx, GLenum prim, GLuint start,
+			    GLuint count, GLuint flags )
+{
+   TNLcontext *tnl = TNL_CONTEXT(ctx);
+   const GLubyte *mask = tnl->vb.ClipMask;
+   GLuint i;
+
+   if (!tnl->Driver.Render.UnclippedTab)
+      return GL_FALSE;
+   for (i = start; i < count; i++)
+      if (mask[i])
+	 return GL_FALSE;
+   tnl->Driver.Render.UnclippedTab[prim]( ctx, start, count, flags );
+   return GL_TRUE;
+}
+
