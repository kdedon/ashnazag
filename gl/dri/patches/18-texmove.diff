+/*
+ * The kernel moved the start of texture memory; its end stays.  Glide
+ * addresses stay relative to where it started, TMU1's half above TMU0's,
+ * but both reach all of it: the memory left is split between them anew.
+ * Every texture goes out and loads again when next used.
+ */
+void tdfxTMMoved_NoLock( tdfxContextPtr fxMesa, int offset )
+{
+   struct gl_shared_state *mesaShared = fxMesa->glCtx->Shared;
+   struct tdfxSharedState *shared = (struct tdfxSharedState *) mesaShared->DriverData;
+   struct gl_texture_object *tObj;
+   tdfxMemRange *r, *next;
+   FxI32 skip = offset - fxMesa->fxScreen->textureOffset;
+   FxU32 start[2], end[2], half;
+   int tmu, n;
+
+   fxMesa->fxScreen->textureNow = offset;
+   if ( !shared )
+      return;
+   for ( tObj = mesaShared->TexObjectList ; tObj ; tObj = tObj->Next )
+      tdfxTMMoveOutTM_NoLock( fxMesa, tObj );
+   n = shared->umaTexMemory || !fxMesa->haveTwoTMUs ? 1 : 2;
+   end[0] = fxMesa->Glide.grTexMaxAddress( 0 );
+   start[0] = skip <= 0 ? 0 : (FxU32) skip;
+   if ( n == 2 ) {
+      half = end[0] + 0x10;	/* TMU0's size: its top address plus the alignment */
+      if ( start[0] > 2 * half - 0x2000 )
+         start[0] = 2 * half - 0x2000;
+      end[0] = half + (start[0] / 2 & ~0xfffU);
+      start[1] = end[0] - half;
+      end[1] = half - 0x10;
+   }
+   else if ( start[0] > end[0] )
+      start[0] = end[0];
+   for ( tmu = 0 ; tmu < n ; tmu++ ) {
+      for ( r = shared->tmFree[tmu] ; r ; r = next ) {
+         next = r->next;
+         DELETE_RANGE_NODE( shared, r );
+      }
+      shared->tmFree[tmu] = NewRangeNode( fxMesa, start[tmu], end[tmu] );
+      shared->totalTexMem[tmu] = shared->freeTexMem[tmu] = end[tmu] - start[tmu];
+   }
+   fxMesa->new_state |= TDFX_NEW_TEXTURE;
+   fxMesa->glCtx->NewState |= _NEW_TEXTURE;
+}
