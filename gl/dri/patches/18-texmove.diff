+/* The kernel moved the card heap: every texture there out, the heap afresh. */
+void r200TexMoved( r200ContextPtr rmesa, int offset, int size )
+{
+   r200ScreenPtr s = rmesa->r200Screen;
+   int h = RADEON_CARD_HEAP;
+
+   r200TexturesGone( rmesa, h, 0, s->texSize[h], 0 );
+   mmDestroy( rmesa->texture.heap[h] );
+   s->texOffset[h] = offset;
+   s->texSize[h] = size;
+   rmesa->texture.heap[h] = mmInit( 0, size );
+   rmesa->texture.cardOffset = offset;
+   r200ResetGlobalLRU( rmesa, h );
+   rmesa->texture.age[h] = rmesa->sarea->texAge[h];
+}
