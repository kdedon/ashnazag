+   driver->handle = NULL;
+   driver->createScreenFunc = (CreateScreenFunc) e->createScreen;
+   driver->registerExtensionsFunc = (RegisterExtensionsFunc) e->registerExtensions;
+   driver->next = Drivers;
+   Drivers = driver;
+   return driver;
+}
