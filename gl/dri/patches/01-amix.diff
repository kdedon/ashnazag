+/*
+ * A node a card, /dev/dri/cardN, made at install; only the card behind
+ * the display opens.  Every open is a client of its own, so the name
+ * and bus id only pick the card.
+ */
+#define AMIX_CARDS 2
+
+static int drmOpenMinor(int minor, int create)
+{
+    int  fd;
+    char buf[64];
+
+    sprintf(buf, DRM_DEV_NAME, DRM_DIR_NAME, minor);
+    if ((fd = open(buf, O_RDWR, 0)) >= 0) return fd;
+    return -errno;
+}
+
+int drmAvailable(void)
+{
+    drmVersionPtr version;
+    int           retval = 0;
+    int           fd, minor;
+
+    for (minor = 0; minor < AMIX_CARDS && !retval; minor++) {
+	if ((fd = drmOpenMinor(minor, 0)) < 0) continue;
+	if ((version = drmGetVersion(fd))) {
+	    retval = 1;
+	    drmFreeVersion(version);
+	}
+	close(fd);
+    }
+    return retval;
+}
+
+int drmOpen(const char *name, const char *busid)
+{
+    drmVersionPtr version;
+    char          *id;
+    int           fd, ok, minor;
+
+    for (minor = 0; minor < AMIX_CARDS; minor++) {
+	if ((fd = drmOpenMinor(minor, 0)) < 0) continue;
+	if (busid) {
+	    id = drmGetBusid(fd);
+	    ok = id && !strcmp(id, busid);
+	    if (id) drmFreeBusid(id);
+	} else {
+	    version = drmGetVersion(fd);
+	    ok = version && !strcmp(version->name, name);
+	    if (version) drmFreeVersion(version);
+	}
+	if (ok) return fd;
+	close(fd);
+    }
+    return -1;
+}
+
+/* the display session of fbfd, an open /dev/fbN, becomes fd's */
+int drmDSBind(int fd, int fbfd, drmDSBindPtr bind)
+{
+    drm_dsbind_t b;
+
+    memset(&b, 0, sizeof(b));
+    b.fd = fbfd;
+    if (ioctl(fd, DRM_IOCTL_DSBIND, &b)) return -errno;
+    bind->session  = b.session;
+    bind->offset   = b.offset;
+    bind->vram     = b.vram;
+    bind->vramsize = b.vramsize;
+    return 0;
+}
+
+/* the card behind fbfd's display, bound to its session; -ENXIO none */
+int drmOpenSession(int fbfd, drmDSBindPtr bind)
+{
+    int fd, minor, e = -ENXIO;
+
+    for (minor = 0; minor < AMIX_CARDS; minor++) {
+	if ((fd = drmOpenMinor(minor, 0)) < 0) {
+	    if (fd != -ENOENT && fd != -ENXIO) e = fd;
+	    continue;
+	}
+	if ((e = drmDSBind(fd, fbfd, bind)) == 0) return fd;
+	close(fd);
+    }
+    return e;
+}
