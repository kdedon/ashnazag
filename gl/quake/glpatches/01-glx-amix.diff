+#ifdef AMIX
+/* SGIS multitexture on top of ARB: same calls, other target enums */
+static void mtex_coord(GLenum t, GLfloat s, GLfloat u)
+{
+	glMultiTexCoord2fARB(t - TEXTURE0_SGIS + GL_TEXTURE0_ARB, s, u);
+}
+
+static void mtex_select(GLenum t)
+{
+	glActiveTextureARB(t - TEXTURE0_SGIS + GL_TEXTURE0_ARB);
+}
+
+static void *amix_glsym(const char *n)
+{
+	if (!strcmp(n, "glMTexCoord2fSGIS"))
+		return (void *)mtex_coord;
+	if (!strcmp(n, "glSelectTextureSGIS"))
+		return (void *)mtex_select;
+	return (void *)glXGetProcAddressARB((const GLubyte *)n);
+}
