+#ifdef AMIX
+#define MAX_ARRAY_VERTS	2048
+
+/* Strips, then fans, each mode one draw over vertices copied in order */
+static void GL_DrawAliasFrameArrays (aliashdr_t *paliashdr, int posenum)
+{
+	static float	xyz[MAX_ARRAY_VERTS][3], st[MAX_ARRAY_VERTS][2];
+	static unsigned	rgba[MAX_ARRAY_VERTS];
+	static GLint	first[MAX_ARRAY_VERTS];
+	static GLsizei	count[MAX_ARRAY_VERTS];
+	trivertx_t	*verts, *v;
+	int		*order, c, k, n, np, fan;
+	float		*p, *t, scale = shadelight * 255;
+	unsigned	*col, l;
+	union { float f; unsigned u; } r;
+
+	verts = (trivertx_t *)((byte *)paliashdr + paliashdr->posedata);
+	verts += posenum * paliashdr->poseverts;
+
+	glVertexPointer (3, GL_FLOAT, 0, xyz);
+	glColorPointer (4, GL_UNSIGNED_BYTE, 0, rgba);
+	glTexCoordPointer (2, GL_FLOAT, 0, st);
+	glEnableClientState (GL_VERTEX_ARRAY);
+	glEnableClientState (GL_COLOR_ARRAY);
+	glEnableClientState (GL_TEXTURE_COORD_ARRAY);
+
+	n = 0;
+	p = xyz[0];
+	t = st[0];
+	col = rgba;
+	for (fan = 0 ; fan < 2 ; fan++)
+	{
+		np = 0;
+		v = verts;
+		order = (int *)((byte *)paliashdr + paliashdr->commands);
+		while ((c = *order++))
+		{
+			k = c < 0 ? -c : c;
+			if ((c < 0) != fan)
+			{
+				order += 2 * k;
+				v += k;
+				continue;
+			}
+			first[np] = n;
+			count[np++] = k;
+			n += k;
+			do
+			{
+				t[0] = ((float *)order)[0];
+				t[1] = ((float *)order)[1];
+				order += 2;
+				t += 2;
+				// adding 2^23 rounds to an integer in the low mantissa bits
+				r.f = shadedots[v->lightnormalindex] * scale + 8388608.0f;
+				l = r.u & 0x7fffff;
+				if (l > 255)
+					l = 255;
+				*col++ = l << 24 | l << 16 | l << 8 | 255;	// RGBA bytes
+				p[0] = v->v[0];
+				p[1] = v->v[1];
+				p[2] = v->v[2];
+				p += 3;
+				v++;
+			} while (--k);
+		}
+		if (np)
+			glMultiDrawArraysEXT (fan ? GL_TRIANGLE_FAN : GL_TRIANGLE_STRIP,
+				first, count, np);
+	}
+
+	glDisableClientState (GL_VERTEX_ARRAY);
+	glDisableClientState (GL_COLOR_ARRAY);
+	glDisableClientState (GL_TEXTURE_COORD_ARRAY);
+	// the colour immediate mode would have left current
+	v = verts + paliashdr->poseverts - 1;
+	scale = shadedots[v->lightnormalindex] * shadelight;
+	glColor3f (scale, scale, scale);
+}
+#endif
