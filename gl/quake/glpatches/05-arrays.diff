+#ifdef AMIX
+#define MAX_ARRAY_VERTS	256
+
+/* A texture chain's lightmapped polygons, one draw per lightmap */
+static void R_DrawChainArrays (texture_t *t)
+{
+	static float		vb[MAX_ARRAY_VERTS][VERTEXSIZE];
+	static GLint		first[MAX_ARRAY_VERTS];
+	static GLsizei		count[MAX_ARRAY_VERTS];
+	static msurface_t	*lmchain[MAX_LIGHTMAPS];
+	msurface_t	*s;
+	glpoly_t	*p;
+	glRect_t	*r;
+	int			i, n, np;
+
+	for (s = t->texturechain ; s ; s = s->texturechain)
+	{
+		if (s->flags & (SURF_DRAWSKY|SURF_DRAWTURB|SURF_UNDERWATER) ||
+			s->polys->numverts > MAX_ARRAY_VERTS)
+		{
+			R_DrawSequentialPoly (s);
+			continue;
+		}
+		R_RenderDynamicLightmaps (s);
+		s->lightmapchain = lmchain[s->lightmaptexturenum];
+		lmchain[s->lightmaptexturenum] = s;
+	}
+
+	glVertexPointer (3, GL_FLOAT, VERTEXSIZE*sizeof(float), &vb[0][0]);
+	glEnableClientState (GL_VERTEX_ARRAY);
+	glClientActiveTextureARB (GL_TEXTURE1_ARB);
+	glTexCoordPointer (2, GL_FLOAT, VERTEXSIZE*sizeof(float), &vb[0][5]);
+	glEnableClientState (GL_TEXTURE_COORD_ARRAY);
+	glClientActiveTextureARB (GL_TEXTURE0_ARB);
+	glTexCoordPointer (2, GL_FLOAT, VERTEXSIZE*sizeof(float), &vb[0][3]);
+	glEnableClientState (GL_TEXTURE_COORD_ARRAY);
+
+	for (i=0 ; i<MAX_LIGHTMAPS ; i++)
+	{
+		if (!lmchain[i])
+			continue;
+		GL_SelectTexture(TEXTURE0_SGIS);
+		GL_Bind (R_TextureAnimation (t)->gl_texturenum);
+		glTexEnvf(GL_TEXTURE_ENV, GL_TEXTURE_ENV_MODE, GL_REPLACE);
+		GL_EnableMultitexture();
+		GL_Bind (lightmap_textures + i);
+		if (lightmap_modified[i])
+		{
+			lightmap_modified[i] = false;
+			r = &lightmap_rectchange[i];
+			glTexSubImage2D(GL_TEXTURE_2D, 0, 0, r->t,
+				BLOCK_WIDTH, r->h, gl_lightmap_format, GL_UNSIGNED_BYTE,
+				lightmaps+(i* BLOCK_HEIGHT + r->t) *BLOCK_WIDTH*lightmap_bytes);
+			r->l = BLOCK_WIDTH;
+			r->t = BLOCK_HEIGHT;
+			r->h = 0;
+			r->w = 0;
+		}
+		glTexEnvf(GL_TEXTURE_ENV, GL_TEXTURE_ENV_MODE, GL_BLEND);
+
+		n = np = 0;
+		for (s = lmchain[i] ; s ; s = s->lightmapchain)
+		{
+			p = s->polys;
+			if (n + p->numverts > MAX_ARRAY_VERTS)
+			{
+				glMultiDrawArraysEXT (GL_POLYGON, first, count, np);
+				n = np = 0;
+			}
+			memcpy (vb[n], p->verts, p->numverts * sizeof(vb[0]));
+			first[np] = n;
+			count[np++] = p->numverts;
+			n += p->numverts;
+		}
+		glMultiDrawArraysEXT (GL_POLYGON, first, count, np);
+		lmchain[i] = NULL;
+	}
+
+	glDisableClientState (GL_VERTEX_ARRAY);
+	glClientActiveTextureARB (GL_TEXTURE1_ARB);
+	glDisableClientState (GL_TEXTURE_COORD_ARRAY);
+	glClientActiveTextureARB (GL_TEXTURE0_ARB);
+	glDisableClientState (GL_TEXTURE_COORD_ARRAY);
+}
+#endif
