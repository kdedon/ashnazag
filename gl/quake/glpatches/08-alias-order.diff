diff -u a/src/gl_mesh.c b/src/gl_mesh.c
--- a/src/gl_mesh.c
+++ b/src/gl_mesh.c
@@ -342,6 +342,30 @@
 	}
 
 
+#ifdef AMIX
+	{
+		// strips first, then fans, so each mode is one run of arrays
+		static int	cmd2[8192], order2[8192];
+		int			*c, k, n, o, v, fan;
+
+		n = o = 0;
+		for (fan = 0 ; fan < 2 ; fan++)
+			for (c = commands, v = 0 ; *c ; c += 1 + 2 * k, v += k)
+			{
+				k = *c < 0 ? -*c : *c;
+				if ((*c < 0) != fan)
+					continue;
+				memcpy (cmd2 + n, c, (1 + 2 * k) * 4);
+				n += 1 + 2 * k;
+				memcpy (order2 + o, vertexorder + v, k * 4);
+				o += k;
+			}
+		cmd2[n] = 0;
+		memcpy (commands, cmd2, (n + 1) * 4);
+		memcpy (vertexorder, order2, o * 4);
+	}
+#endif
+
 	// save the data out
 
 	paliashdr->poseverts = numorder;
@@ -356,5 +380,32 @@
 	for (i=0 ; i<paliashdr->numposes ; i++)
 		for (j=0 ; j<numorder ; j++)
 			*verts++ = poseverts[i][vertexorder[j]];
+#ifdef AMIX
+	{
+		// nstrips, nfans, first[], count[], then s/t per vertex
+		int		*a, *c, k, np = 0, nf = 0, n = 0;
+		float	*st;
+
+		for (c = cmds ; *c ; c += 1 + 2 * k, np++)
+		{
+			k = *c < 0 ? -*c : *c;
+			nf += *c < 0;
+		}
+		a = Hunk_Alloc ((2 + 2 * np + 2 * numorder) * 4);
+		paliashdr->arrays = (byte *)a - (byte *)paliashdr;
+		a[0] = np - nf;
+		a[1] = nf;
+		st = (float *)(a + 2 + 2 * np);
+		for (c = cmds, j = 0 ; *c ; c += 1 + 2 * k, j++)
+		{
+			k = *c < 0 ? -*c : *c;
+			a[2 + j] = n;
+			a[2 + np + j] = k;
+			n += k;
+			memcpy (st, c + 1, 2 * k * 4);
+			st += 2 * k;
+		}
+	}
+#endif
 }
 
