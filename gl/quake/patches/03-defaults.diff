+/* the game data sits next to the binary, wherever it is started from */
+static char *Sys_BaseDir (char *argv0)
+{
+	static char dir[MAX_OSPATH];
+	char *p, *e;
+	int n;
+
+	if (!strchr(argv0, '/')) {
+		for (p = getenv("PATH"); p && *p; p = *e ? e + 1 : e) {
+			e = strchr(p, ':');
+			if (!e)
+				e = p + strlen(p);
+			n = e - p;
+			if (n == 0 || n + strlen(argv0) + 2 > sizeof dir)
+				continue;
+			sprintf(dir, "%.*s/%s", n, p, argv0);
+			if (access(dir, X_OK) == 0) {
+				dir[n] = 0;
+				return dir;
+			}
+		}
+		return ".";
+	}
+	if (strlen(argv0) >= sizeof dir)
+		return ".";
+	strcpy(dir, argv0);
+	p = strrchr(dir, '/');
+	p[p == dir] = 0;
+	return dir;
+}
