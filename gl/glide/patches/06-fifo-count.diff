--- a/gglide.c
+++ b/gglide.c
@@ -1170,6 +1170,27 @@
 #define FN_NAME "grBufferSwap"
   GR_BEGIN_NOFIFOCHECK(FN_NAME,86);
   GDBG_INFO_MORE(gc->myLevel,"(%d)\n",swapInterval);
+#ifdef __m68k__
+  /* FX_FIFOCOUNT=n: fifo words per frame, averaged over n frames */
+  {
+    extern FxU32 _grFifoWords, *_grFifoMark;
+    static int every = -1, frames;
+    FxU32 *p = gc->cmdTransportInfo.fifoPtr;
+
+    if (every < 0)
+      every = getenv("FX_FIFOCOUNT") ? atoi(getenv("FX_FIFOCOUNT")) : 0;
+    if (every > 0) {
+      if (_grFifoMark && p >= _grFifoMark)
+        _grFifoWords += p - _grFifoMark;
+      _grFifoMark = p;
+      if (++frames == every) {
+        fprintf(stderr, "fifo %lu words/frame\n", _grFifoWords / every);
+        frames = 0;
+        _grFifoWords = 0;
+      }
+    }
+  }
+#endif
 
