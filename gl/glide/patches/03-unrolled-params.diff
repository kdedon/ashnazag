+/* A vertex's parameters after x and y, the n offsets of tsuDataList,
+ * without walking the list.
+ */
+#define TRI_SETF_PARAMS(__v, __n) \
+do { \
+  const int *__e = gc->tsuDataList + (__n); \
+  switch (__n) { \
+  default: { \
+    int __k; \
+    for (__k = 0; __k < (__n) - 12; __k++) \
+      TRI_SETF(FARRAY(__v, gc->tsuDataList[__k])); \
+  } \
+  case 12: TRI_SETF(FARRAY(__v, __e[-12])); \
+  case 11: TRI_SETF(FARRAY(__v, __e[-11])); \
+  case 10: TRI_SETF(FARRAY(__v, __e[-10])); \
+  case 9: TRI_SETF(FARRAY(__v, __e[-9])); \
+  case 8: TRI_SETF(FARRAY(__v, __e[-8])); \
+  case 7: TRI_SETF(FARRAY(__v, __e[-7])); \
+  case 6: TRI_SETF(FARRAY(__v, __e[-6])); \
+  case 5: TRI_SETF(FARRAY(__v, __e[-5])); \
+  case 4: TRI_SETF(FARRAY(__v, __e[-4])); \
+  case 3: TRI_SETF(FARRAY(__v, __e[-3])); \
+  case 2: TRI_SETF(FARRAY(__v, __e[-2])); \
+  case 1: TRI_SETF(FARRAY(__v, __e[-1])); \
+  case 0: break; \
+  } \
+} while(0)
