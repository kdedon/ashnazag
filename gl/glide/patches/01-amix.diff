diff -ruN pa/glide/fxhal.h pb/glide/fxhal.h
--- a/fxhal.h
+++ b/fxhal.h
@@ -249,7 +249,64 @@
 #else /* !defined(__MWERKS__) && POWERPC */
 #error "Define byte swapped macros for GET/SET"
 #endif /* !defined(__MWERKS__) && POWERPC */
+#elif defined(__m68k__)
+/*
+ * The bridge passes bytes in address order: a register long reaches the
+ * card byte reversed.  The command fifo lies in the frame buffer
+ * aperture, which swaps the bytes of each 16-bit pixel and so turns a
+ * long's halves around.
+ */
+#undef GET
+#undef GET16
+#undef SET
+#undef SET16
+#undef SETF
+#undef SET_FIFO
+#undef SETF_FIFO
+
+static __inline__ FxU32 _amixSwab32(FxU32 v)
+{
+	__asm__("rol.w &8,%0\n\tswap %0\n\trol.w &8,%0" : "=d" (v) : "0" (v));
+	return v;
+}
+
+static __inline__ FxU32 _amixWswap32(FxU32 v)
+{
+	__asm__("swap %0" : "=d" (v) : "0" (v));
+	return v;
+}
+
+static __inline__ FxU32 _amixFbits(float f)
+{
+	union { float f; FxU32 u; } x;
+
+	x.f = f;
+	return x.u;
+}
+
+#define GET(s)          _amixSwab32(*(volatile FxU32 *)&(s))
+#define GET16(s)        ((FxU16)(_amixSwab32(*(volatile FxU16 *)&(s)) >> 16))
+#define SET(d, s)       (*(volatile FxU32 *)&(d) = _amixSwab32(s))
+#define SET16(d, s)     (*(volatile FxU16 *)&(d) = _amixSwab32((FxU16)(s)) >> 16)
+#define SETF(d, s)      (*(volatile FxU32 *)&(d) = _amixSwab32(_amixFbits(s)))
+#define SET_FIFO(d, s)  (*(volatile FxU32 *)&(d) = _amixWswap32(s))
+#define SETF_FIFO(d, s) (*(volatile FxU32 *)&(d) = _amixWswap32(_amixFbits(s)))
+/* 16-bit texels arrive in place; 8-bit ones need their pairs swapped */
+#define SET_LINEAR(d, s)    SET_FIFO(d, s)
+#define SET_LINEAR_16(d, s) (*(volatile FxU32 *)&(d) = (s))
+#define SET_LINEAR_8(d, s)  SET_FIFO(d, _amixSwab32(s))
+/* frame buffer pixels read and written by the CPU need no swapping */
+#define LFB_GET(s)      (s)
+#define LFB_GET16(s)    (*(volatile FxU16 *)&(s))
+#define LFB_SET(d, s)   ((d) = (s))
+#define LFB_SET16(d, s) (*(volatile FxU16 *)&(d) = (s))
 #endif /* SET_BSWAP */
+#ifndef LFB_GET
+#define LFB_GET(s)      GET(s)
+#define LFB_GET16(s)    GET16(s)
+#define LFB_SET(d, s)   SET(d, s)
+#define LFB_SET16(d, s) SET16(d, s)
+#endif
 
 #define GET_IO8(p)      pioInByte(p)
 #define GET_IO16(p)     pioInWord(p)
