#!/bin/sh
# The environment module path: this host's own builds first.  The kernel
# names the machine; the 68030 Atari kernel's name ends in 030.
case `uname -m` in
Atari*030)	d=/usr/aux/lib/mod.atari ;;
Atari*)		d=/usr/aux/lib/mod.atari060 ;;
A[0-9]*|[Aa]miga*)	d=/usr/aux/lib/mod.amiga ;;
*)		d= ;;
esac
if [ -n "$d" ] && [ -d "$d" ]; then
	echo "$d:/usr/aux/lib/mod.d"
else
	echo /usr/aux/lib/mod.d
fi
