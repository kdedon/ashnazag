#!/sbin/sh
# startmac -- the Mac environment, as on A/UX: root's System Folder is
# /mac/sys/System Folder, other users get $HOME/System Folder from
# makemac; both are copies of /mac/lib/System Folder, refreshed when it
# changes.  startmac -e env uses environment env's System Folder, from
# makemac -e env.  One session per System Folder: a second is refused.
#
# /etc/aux/macenv.conf (shell syntax) or the environment may set
#   TBMEMORY  Mac memory, e.g. 32M; default a quarter of physical
#             memory, 8 to 32 MB, as free swap allows
#   MACMODEL  Gestalt machine ID the Mac reports, e.g. 35 Quadra 800
#             (root only); unset picks one from the host and the ROM
# The environment wins.
PATH=/usr/bin:/sbin:/usr/sbin
umask 022
m=$MACMODEL t=$TBMEMORY
[ -r /etc/aux/macenv.conf ] && . /etc/aux/macenv.conf
MACMODEL=${m:-$MACMODEL} TBMEMORY=${t:-$TBMEMORY}
e=
if [ "$1" = -e ]; then
	[ $# -ge 2 ] || { echo "usage: startmac [-e env] [arg ...]" >&2; exit 2; }
	e=$2
	shift 2
	case $e in
	default) e= ;;
	[Ss][Hh][Aa][Rr][Ee][Dd]|[!A-Za-z0-9]*|*[!-A-Za-z0-9._]*)
		echo "startmac: $e: not an environment name" >&2
		exit 1 ;;
	esac
fi
ps -e | grep -s ' fidd$' > /dev/null || /etc/aux/fidd < /dev/null
case `id` in
uid=0\(*)
	H=/mac/sys
	# uinter reads the model from /etc/aux/model
	if [ "$MACMODEL" != "`cat /etc/aux/model 2> /dev/null`" ]; then
		if [ -n "$MACMODEL" ]; then
			echo "$MACMODEL" > /etc/aux/model
		else
			rm -f /etc/aux/model
		fi
	fi ;;
*)
	[ -z "$MACMODEL" ] || echo "startmac: only root sets MACMODEL" >&2
	H=$HOME ;;
esac
S="$H/System Folder"
# the session locks the environment's metadata file, or the legacy
# folder's stamp; a missing stamp comes with the refresh below
F="$S/.stamp"
if [ -n "$e" ]; then
	# the layout policy is data: KEY=value lines, never run
	R=`sed -n 's/^ENVIRONMENT_ROOT=//p' /etc/default/mac 2> /dev/null | sed 1q`
	case ${R:="~/Mac"} in
	"~/"*)	R=$HOME/`expr "x$R" : 'x~/\(.*\)'` ;;
	esac
	M=`sed -n 's/^ENVIRONMENT_METADATA=//p' /etc/default/mac 2> /dev/null | sed 1q`
	L=$R/$e
	S="$L/System Folder"
	F=$L/${M:-.env}
	[ -d "$L" ] || { echo "startmac: no environment $e; run makemac -e $e" >&2; exit 1; }
	[ -f "$F" ] || : >> "$F"
fi
envlock -t "$F" || exit 1
# a new or outdated copy of the template
[ -f "$S/System" ] && cmp -s "/mac/lib/System Folder/.stamp" "$S/.stamp" || {
	[ ! -f "$S/System" ] || echo "startmac: updating $S"
	if [ -n "$e" ]; then
		makemac -f -e "$e" > /dev/null
	else
		HOME=$H makemac -f > /dev/null
	fi && [ -f "$S/System" ] ||
		{ echo "startmac: cannot make $S" >&2; exit 1; }
}
macscrn "$S/%System" 2> /dev/null
if [ -z "$TBMEMORY" ]; then
	# swap backs Mac memory; startmac takes less when it runs short
	p=`cat /etc/aux/memsize 2> /dev/null`
	a=`swap -s 2> /dev/null | nawk '/^total:/ { print int($(NF - 2) / 2048) - 8 }'`
	m=`expr "${p:-32}" / 4`
	[ $m -le 32 ] || m=32
	[ $m -le "${a:-32}" ] || m=${a:-32}
	[ $m -ge 8 ] || m=8
	TBMEMORY=${m}M
fi
# Mac RAM counts against the soft memory limit: raise it to cover
# TBMEMORY and 16 MB more, as far as the hard limit allows
k=`echo "$TBMEMORY" | nawk '{ n = $0 + 0
	if ($0 ~ /[Mm]$/) n *= 1024; else if ($0 !~ /[Kk]$/) n = int(n / 1024)
	print n + 16384 }'`
h=`ulimit -H -v`
if [ "$h" != unlimited ] && [ "$h" -lt "$k" ]; then
	m=`expr \( $h - 16384 \) / 1024`
	echo "startmac: TBMEMORY=$TBMEMORY needs a memory limit of ${k}K, the hard limit is ${h}K: ${m}M" >&2
	[ $m -ge 3 ] || exit 1
	TBMEMORY=${m}M k=$h
fi
v=`ulimit -v`
[ "$v" = unlimited ] || [ "$v" -ge "$k" ] || ulimit -v $k
TBSYSTEM=${TBSYSTEM:-$S}
export TBSYSTEM TBMEMORY
[ -t 0 ] || exec envlock "$F" /mac/bin/startmac "$@"
# the Mac has the keyboard: no echo, and what the tty got meanwhile is
# dropped, not run by the shell afterwards
t=`stty -g`
# a signal from the keyboard is the Mac's; the tty comes back either way
trap : 2 3
trap 'stty $t; exit 1' 1 15
stty -echo
envlock "$F" /mac/bin/startmac "$@"
r=$?
stty -icanon min 0 time 0
cat > /dev/null
stty $t
exit $r
