#!/sbin/sh
# startmac -- the Mac environment, as on A/UX.
#
#	startmac [-e env [-b base]] [-d env] [-R] [arg ...]
#	startmac -d env | -l
#
# Environments: 7.6.1, from /mac/lib/System Folder; one for each
# /mac/lib/env/env/System Folder (8.1: Mac OS 8.1; 6: System 6.0.7 with
# MultiFinder, run by A/UX 2.0.1's startmac in /usr/aux/aux2).
# Without -e it is the default: -d sets the user's, /etc/default/mac
# (DEFAULT_ENVIRONMENT) the system's; -l lists them.  A new name is the
# user's own copy of base, by default the default.  Root's 7.6.1 System
# Folder is /mac/sys/System Folder, another user's ~/System Folder; the
# others' are in ~/Mac/env.  A user's
# System Folder is copied from the template at first start and again
# when it changes or with -R, keeping Preferences, the desktop database,
# MacTCP settings and other files.  One session per System Folder: a second is
# refused.
#
# /etc/aux/macenv.conf (shell syntax) or the environment may set
#   TBMEMORY  Mac memory, e.g. 32M; default a quarter of physical
#             memory, 8 to 32 MB, as free swap allows; System 6 takes
#             only the environment's, default 4M
#   MACMODEL  Gestalt machine ID the Mac reports, e.g. 35 Quadra 800
#             (root only); unset picks one from the host and the ROM
# The environment wins.
PATH=/usr/bin:/sbin:/usr/sbin
umask 022
m=$MACMODEL t=$TBMEMORY
[ -r /etc/aux/macenv.conf ] && . /etc/aux/macenv.conf
MACMODEL=${m:-$MACMODEL} TBMEMORY=${t:-$TBMEMORY}
usage() {
	echo "usage: startmac [-e env [-b base]] [-d env] [-R] [arg ...] | startmac -d env | -l" >&2
	exit 2
}
name() {
	case $1 in
	[Ss][Hh][Aa][Rr][Ee][Dd]|[!A-Za-z0-9]*|*[!-A-Za-z0-9._]*)
		echo "startmac: $1: not an environment name" >&2
		exit 1 ;;
	esac
	[ `expr "x$1" : '.*'` -le 65 ] || { echo "startmac: $1: name too long" >&2; exit 1; }
}
# the layout policy is data: KEY=value lines, never run
pol() {
	v=`sed -n "s/^$1=//p" /etc/default/mac 2> /dev/null | sed 1q`
	[ -n "$v" ] || v=$2
	case $v in
	"~/"*)	v=$HOME/`expr "x$v" : 'x~/\(.*\)'` ;;
	esac
	echo "$v"
}
R=`pol ENVIRONMENT_ROOT "~/Mac"`
MN=`pol ENVIRONMENT_METADATA .env`
# the user's default, else the system's
dflt() {
	d=`sed -n 's/^DEFAULT_ENVIRONMENT=//p' "$HOME/.default/mac" 2> /dev/null | sed 1q`
	[ -n "$d" ] || d=`pol DEFAULT_ENVIRONMENT 7.6.1`
	echo "$d"
}
# the template of environment $1
tmpl() {
	if [ "$1" = 7.6.1 ]; then
		echo "/mac/lib/System Folder"
	elif [ -d "/mac/lib/env/$1/System Folder" ]; then
		echo "/mac/lib/env/$1/System Folder"
	elif [ -f "$R/$1/$MN" ]; then
		t=`sed -n 's/^template=//p' "$R/$1/$MN" | sed 1q`
		echo "${t:-/mac/lib/System Folder}"
	fi
}
e= def= b= refresh=
while [ $# -gt 0 ]; do
	case $1 in
	-e)	[ $# -ge 2 ] || usage; e=$2; shift 2 ;;
	-d)	[ $# -ge 2 ] || usage; def=$2; shift 2 ;;
	-b)	[ $# -ge 2 ] || usage; b=$2; shift 2 ;;
	-R)	refresh=1; shift ;;
	-l)	d=`dflt`
		{
			echo 7.6.1
			for i in /mac/lib/env/*/System\ Folder; do
				[ -d "$i" ] && expr "x$i" : 'x/mac/lib/env/\(.*\)/System Folder$'
			done
			for i in "$R"/*/"$MN"; do
				[ -f "$i" ] && expr "x$i" : ".*/\([^/]*\)/$MN\$"
			done
		} | while read i; do
			case " $seen " in *" $i "*) continue ;; esac
			seen="$seen $i"
			if [ "$i" = "$d" ]; then echo "$i (default)"; else echo "$i"; fi
		done
		exit 0 ;;
	*)	break ;;
	esac
done
if [ -n "$def" ]; then
	name "$def"
	{ [ -d "$HOME/.default" ] || mkdir -p "$HOME/.default"; } && echo "DEFAULT_ENVIRONMENT=$def" > "$HOME/.default/mac" || exit 1
	[ -n "$e" ] || exit 0
fi
[ -z "$b" ] || [ -n "$e" ] || usage
[ -n "$e" ] || e=`dflt`
name "$e"
case $e in
6|7.6.1) [ -z "$b" ] || { echo "startmac: $e exists; -b makes a new environment" >&2; exit 1; } ;;
esac
login=`id | sed 's/^uid=[0-9]*(\([^)]*\)).*/\1/'`
# the session's tty: no echo, and what it got meanwhile is dropped, not
# run by the shell afterwards; a signal from the keyboard is the Mac's
run() {
	[ -t 0 ] || exec envlock "$F" "$@"
	t=`stty -g`
	trap : 2 3
	trap 'stty $t; exit 1' 1 15
	stty -echo
	envlock "$F" "$@"
	r=$?
	stty -icanon min 0 time 0
	cat > /dev/null
	stty $t
	exit $r
}
case $login in
root)
	H=/mac/sys
	# uinter reads the model from /etc/aux/model
	if [ "$MACMODEL" != "`cat /etc/aux/model 2> /dev/null`" ]; then
		if [ -n "$MACMODEL" ]; then
			echo "$MACMODEL" > /etc/aux/model
		else
			rm -f /etc/aux/model
		fi
	fi ;;
*)
	[ -z "$MACMODEL" ] || echo "startmac: only root sets MACMODEL" >&2
	H=$HOME ;;
esac
# the Trash and Temporary Items: $HOME/.mac/<host>, owner only
case $HOME in ""|/) d=/.mac ;; *) d=$HOME/.mac ;; esac
[ ! -d "$d" ] || chmod 700 "$d" 2> /dev/null
# the session locks the environment's metadata file, or 7.6.1's stamp
P="/mac/lib/System Folder"
if [ "$e" = 7.6.1 ]; then
	S="$H/System Folder"
	F="$S/.stamp"
else
	L=$R/$e
	S="$L/System Folder"
	F=$L/$MN
	if [ -f "$F" ] || [ -d "/mac/lib/env/$e/System Folder" ]; then
		[ -z "$b" ] || { echo "startmac: $e exists; -b makes a new environment" >&2; exit 1; }
		P=`tmpl "$e"`
	else
		[ -n "$b" ] || b=`dflt`
		name "$b"
		P=`tmpl "$b"`
		[ -n "$P" ] && [ -d "$P" ] || { echo "startmac: no environment $b to copy; startmac -l lists them" >&2; exit 1; }
		echo "startmac: $e is a new copy of $b" >&2
	fi
	[ -d "$L" ] || mkdir -p "$L" || exit 1
	[ -f "$F" ] || {
		echo "id=$e"
		echo "name=$e"
		echo "profile=mac"
		echo "template=$P"
		echo "created=`date -u +%Y-%m-%dT%H:%M:%SZ`"
	} > "$F" || exit 1
fi
envlock -t "$F" || exit 1
# a new or outdated copy of the template; AppleDouble headers (%name)
# go with their files, not the File Manager's caches, which belong to
# their directory; the stamp goes last, so an interrupted copy is redone
[ -z "$refresh" ] && [ -f "$S/System" ] && cmp -s "$P/.stamp" "$S/.stamp" || {
	[ ! -f "$S/System" ] || echo "startmac: updating $S"
	[ -d "$P" ] && { [ -d "$S" ] || mkdir -p "$S"; } && rm -f "$S/.stamp" && (cd "$P" && find . -print | while read f; do
		case $f in
		./.stamp|./%.stamp|*/.fs_*|*/%.fs_*) continue ;;
		./Preferences/*|./Desktop\ D[BF]|./%Desktop\ D[BF]|./Scrapbook\ File|./%Scrapbook\ File|\
		./Control\ Panels/MacTCP|./Control\ Panels/%MacTCP)
			[ -f "$S/$f" ] && continue ;;
		esac
		echo "$f"
	done | cpio -pdmu "$S" 2> /dev/null) && {
		[ $login != root ] || [ ! -f "$P/../RootFinder" -o ! -f "$P/../%RootFinder" ] ||
			{ cp "$P/../RootFinder" "$S/Finder" && cp "$P/../%RootFinder" "$S/%Finder"; }
	} && cp "$P/.stamp" "$S/" && { [ ! -f "$P/%.stamp" ] || cp "$P/%.stamp" "$S/"; } && [ -f "$S/System" ] ||
		{ echo "startmac: cannot make $S" >&2; exit 1; }
}
# System 6 and copies of it: A/UX 2's startmac, AppleSingle files, no fidd
if [ "$P" = "/mac/lib/env/6/System Folder" ]; then
	X=/usr/aux/aux2/mac/bin/startmac
	macscrn "$S/System" 2> /dev/null
	TBMEMORY=${t:-4M}
else
	X=/mac/bin/startmac
	ps -e | grep -s ' fidd$' > /dev/null || /etc/aux/fidd < /dev/null
	macscrn "$S/%System" 2> /dev/null
fi
if [ -z "$TBMEMORY" ]; then
	# swap backs Mac memory; startmac takes less when it runs short
	p=`cat /etc/aux/memsize 2> /dev/null`
	a=`swap -s 2> /dev/null | nawk '/^total:/ { print int($(NF - 2) / 2048) - 8 }'`
	m=`expr "${p:-32}" / 4`
	[ $m -le 32 ] || m=32
	[ $m -le "${a:-32}" ] || m=${a:-32}
	[ $m -ge 8 ] || m=8
	TBMEMORY=${m}M
fi
# Mac RAM counts against the soft memory limit: raise it to cover
# TBMEMORY and 16 MB more, as far as the hard limit allows
k=`echo "$TBMEMORY" | nawk '{ n = $0 + 0
	if ($0 ~ /[Mm]$/) n *= 1024; else if ($0 !~ /[Kk]$/) n = int(n / 1024)
	print n + 16384 }'`
h=`ulimit -H -v`
if [ "$h" != unlimited ] && [ "$h" -lt "$k" ]; then
	m=`expr \( $h - 16384 \) / 1024`
	echo "startmac: TBMEMORY=$TBMEMORY needs a memory limit of ${k}K, the hard limit is ${h}K: ${m}M" >&2
	[ $m -ge 3 ] || exit 1
	TBMEMORY=${m}M k=$h
fi
v=`ulimit -v`
[ "$v" = unlimited ] || [ "$v" -ge "$k" ] || ulimit -v $k
TBSYSTEM=${TBSYSTEM:-$S}
export TBSYSTEM TBMEMORY
run $X "$@"
