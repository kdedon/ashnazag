--- a/kernel/mac/diskroot/root.manifest
+++ b/kernel/mac/diskroot/root.manifest
@@ -55,6 +55,47 @@
 # date(1) runs setclk -s after stime(2); the kernel keeps the RTC
 f /usr/amiga/bin/setclk 755 0 3 etc/setclk
 
+# A/UX Mac environment and TOS container: guest modules registered at run level 2, the
+# File ID daemon, startmac and A/UX's Mac files
+d /usr/aux	755 0 3
+d /usr/aux/lib	755 0 3
+d /usr/aux/lib/mod.d 755 0 3
+f /usr/aux/lib/mod.d/guestcore 644 0 3 macpkg/mod.d/guestcore
+f /usr/aux/lib/mod.d/auxcore	644 0 3 macpkg/mod.d/auxcore
+f /usr/aux/lib/mod.d/auxexec	644 0 3 macpkg/mod.d/auxexec
+f /usr/aux/lib/mod.d/uinter	644 0 3 macpkg/mod.d/uinter
+f /usr/aux/lib/mod.d/tosguest 644 0 3 macpkg/mod.d/tosguest
+f /usr/aux/lib/auxreg	755 0 3 macpkg/auxreg
+f /etc/rc2.d/S05aux	744 0 3 macpkg/S05aux
+c /dev/uinter0	660 0 25 54 0 	# major as in S05aux
+c /dev/tos	660 0 25 56 0
+d /shlib	755 0 3
+f /shlib/libc1_s	755 0 3 macpkg/libc1_s
+f /shlib/libmac1_s	755 0 3 macpkg/libmac1_s
+d /etc/aux	755 0 3
+f /etc/aux/fidd	755 0 3 macpkg/fidd
+f /etc/aux/rom	444 0 3 macpkg/rom
+# A/UX's Mac files: /mac, the Finder's folders at /, systemfolder
+a macpkg/mac.cpio
+f /usr/bin/startmac 755 0 3 macpkg/startmac.sh
+f /usr/bin/makemac 755 0 3 macpkg/makemac
+# guest's ~/System Folder, as makemac makes it
+a macpkg/macguest.cpio
+f /usr/bin/macdiag 750 0 3 macpkg/macdiag
+f /usr/bin/macscrn 755 0 3 macpkg/macscrn
+# TOS container: EmuTOS, its cartridge, the C: folder template /tos/sys,
+# guest's ~/TOS and the system's apps (drive G:)
+d /etc/tos	755 0 3
+f /etc/tos/emutos.img 444 0 3 macpkg/tos/emutos.img
+f /etc/tos/tosml.img 444 0 3 macpkg/tos/tosml.img
+f /usr/bin/starttos 755 0 3 macpkg/tos/starttos
+f /usr/bin/maketos 755 0 3 macpkg/tos/maketos
+f /usr/bin/tosdrive 755 0 3 macpkg/tos/tosdrive
+a macpkg/tos/sys.cpio
+a macpkg/tos/games.cpio
+a macpkg/tos/guest.cpio
+c /dev/kmem	640 0 3 3 1	# macdiag relies on root-only kernel memory
+
 # no Amiga port monitors (screens, serial boards) or Ethernet board
 f /etc/saf/_sactab 644 0 3 etc/_sactab
 f /etc/inet/network-config 444 0 3 etc/network-config
--- a/kernel/mac/diskroot/mkdiskroot.sh
+++ b/kernel/mac/diskroot/mkdiskroot.sh
@@ -40,7 +40,7 @@
 	> "$B/profile"
 x usr/sbin/shutdown | sed -e 's,^if /usr/amiga/bin/sioc &&,if false \&\&,' > "$B/shutdown"
 x etc/screendefs | grep '^#' > "$B/screendefs"
-{ x etc/group | grep -v '^display:'; echo "display::25:"; } > "$B/group"
+{ x etc/group | grep -v '^display:'; echo "display::25:guest"; } > "$B/group"
 x etc/vfstab | sed -e "s,^\(/dev/dsk/c0d0s1[	 ].*[	 ]/[	 ]*\)s5,\1$ROOTFS," > "$B/vfstab"
 grep -q "^/dev/dsk/c0d0s1.*$ROOTFS" "$B/vfstab" || { echo "[FAIL] tape vfstab changed"; exit 1; }
 # flush the file systems before uadmin halts
