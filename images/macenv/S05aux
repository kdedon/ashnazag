# A/UX programs and the Mac environment: modules, File ID daemon.
# 54: the major of /dev/uinter0, 56 of /dev/tos.
umask 022
PATH=/usr/bin:/sbin:/usr/sbin
case $1 in
'start')
	/usr/aux/lib/auxreg /usr/aux/lib/mod.d 54 56 || exit 1
	# fidd finds the root in an A/UX mount table: A/UX's name, this device
	if [ ! -s /etc/mtab ]; then
		ls -lL /dev/dsk/c0d0s1 | nawk '{ sub(",", "", $5)
			printf "/dev/dsk/c0d0s0 / 4.2 rw,noquota,dev=%x 1 1\n", $5 * 256 + $6 }' \
			> /etc/mtab.$$ && [ -s /etc/mtab.$$ ] && mv /etc/mtab.$$ /etc/mtab
		rm -f /etc/mtab.$$
	fi
	[ -d "/Desktop Folder" ] || mkdir "/Desktop Folder"
	chmod 1777 "/Desktop Folder"
	# physical memory in MB, for startmac's default Mac memory
	/usr/bin/macdiag -m > /etc/aux/memsize.$$ && mv /etc/aux/memsize.$$ /etc/aux/memsize
	rm -f /etc/aux/memsize.$$
	# forks and returns
	/etc/aux/fidd < /dev/null ;;
esac
