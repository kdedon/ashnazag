+++ b/src/hat040.s
@@ -672,6 +672,16 @@ Lcm_nc:
 | bit-for-bit what it was before this change.
 Lcm_dev:
 	movel	%fp@(20),%d0		| pfn being mapped
+	cmpl	hat_cm_rom+0,%d0
+	bcs	Lcm_r1
+	cmpl	hat_cm_rom+4,%d0
