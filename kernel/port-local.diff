 	movel	%d0,sup_cacr		| supervisor CACR value (p1int..p4int,p6int restore per
 					| interrupt; p5int loads neither = harmless, values equal)
-	.word	0x4e7b,0x0002		| movec %d0,%cacr  (enable IC + DC now)
