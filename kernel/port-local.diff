 | ===========================================================================
 | hat_cm_fb_add(lo_pfn, hi_pfn) -- register one half-open framebuffer PFN
@@ -726,13 +738,14 @@ Lcm_fb:
 hat_cm_fb_add:
 	linkw	%fp,&0
 	moveml	%d2-%d3/%a2,%sp@-
+	lea	hat_cm_fb,%a2
+Lfa_args:
+	moveq	&2,%d1			| slot count
 	movel	%fp@(8),%d2		| lo
