 	clrl	%d0
 	cmpl	%d2,%d3
 	blsw	Lfa_out			| hi <= lo: empty or inverted -> refuse
-	lea	hat_cm_fb,%a2
-	moveq	&2,%d1			| slot count
 Lfa_loop:
 	movel	%a2@(0),%d0
 	orl	%a2@(4),%d0
@@ -758,6 +771,16 @@ Lfa_out:
 	unlk	%fp
 	rts
 
+| hat_cm_rom_add(lo_pfn, hi_pfn) -- register a read-only ROM PFN interval,
+| mapped cacheable (CM=00) instead of NCS.  Same contract as hat_cm_fb_add:
+| two slots, immutable once installed, installed before the first fault.
+	.globl	hat_cm_rom_add
+hat_cm_rom_add:
+	linkw	%fp,&0
+	moveml	%d2-%d3/%a2,%sp@-
+	lea	hat_cm_rom,%a2
+	braw	Lfa_args
+
 | ===========================================================================
 | hat_unlock (orig 0xb5d1e, GLOBAL T) -- 040 port.
 | Decrements the lock count on the page-table page holding va's leaf PTE, and
@@ -860,7 +883,7 @@ Lhu_done:
 | THIS port: the 040 leaf PTE address is ALREADY in p_mapping (hat_pteload set pp->p_mapping=&PTE),
 | so just clrl each PTE (UDT->0 invalid) directly -- no tree walk -- then cpusha+pflusha so the HW
 | walker reloads the invalid descriptor and the next access faults & re-maps.  CONSERVATIVE: does
-| NOT free the now-emptier leaf tables or adjust as->a_rss (a bounded leak / soft-count drift, same
+| NOT free the now-emptier leaf tables (a bounded leak, same
 | philosophy as hat_free040) -- correctness (no stale resident PTE on a freed page) comes first.
 |
 | 2026-07-18 ISSUE-10 PRODUCER FIX: harvest each PTE's HW U/M bits into pp->p_ref/p_mod BEFORE
@@ -898,6 +921,32 @@ Lpu_loop:
 	bfextu	%a0@{&3:&1},%d1
 	orl	%d1,%d0
 	bfins	%d0,%a2@{&5:&1}		| pp->p_mod |= PTE M
+	tstl	%a3@
+	beqw	Lpu_clr
+| the owner's resident count drops with the mapping; hat_unload skips cleared leaves
+	movel	%a3,%d0
+	andil	&0xffffff00,%d0		| leaf base
+	movel	%d0,%d1
+	moveq	&12,%d2
+	lsrl	%d2,%d1
+	cmpl	pages_base,%d1
+	bcsw	Lpu_clr
+	cmpl	pages_end,%d1
+	bccw	Lpu_clr
+	subqw	&8,%sp
+	movel	%sp,%sp@-
+	movel	%d0,%sp@-
+	jsr	hat_pt2ptdat
+	lea	%sp@(16),%sp
+	movel	%a0,%d0
+	beqs	Lpu_clr
+	movel	%a0@,%d0		| ptdat->as
+	beqs	Lpu_clr
+	moveal	%d0,%a0
+	tstl	%a0@(16)
+	beqs	Lpu_clr
+	subql	&1,%a0@(16)		| as rss--
+Lpu_clr:
 	clrl	%a3@			| *pte = 0 -> 040 leaf descriptor INVALID (UDT=0)
 	movel	%d3,%d2			| advance to next mapping
 	braw	Lpu_loop
@@ -2060,6 +2109,13 @@ hat_cm_fb:
 	.balign 4
 hat_cm_ram:
 	.long	0x00000020		| B2: CM=01 copyback for managed RAM (default since 2026-07-30)
+
+| hat_cm_rom: registered ROM PFN intervals, {lo, hi} half-open, two slots;
+| written only by hat_cm_rom_add, read only by Lcm_dev.
+	.globl	hat_cm_rom
+	.balign 4
+hat_cm_rom:
+	.long	0, 0, 0, 0
 	.balign 4
 Lbt_ptl_done:
 	.long	0			| btrace 'P' one-shot guard (first hat_pteload)
diff --git a/src/krnxmemflt040.s b/src/krnxmemflt040.s
index 326ed16..e1cdcc9 100644
--- a/src/krnxmemflt040.s
+++ b/src/krnxmemflt040.s
@@ -300,6 +300,18 @@ Lkx_ret:
 	andil	&0xfff,%d1
 	cmpil	&0xff8,%d1
 	bcsw	Lkx_nox			| neither MA nor the window -> nothing to do
+| --- The window is a guess: never cross into the next 8 KiB segkmap slot, which maps
+|     another file, maybe one on an unmounted file system. ---
+	moveal	segkmap,%a0
+	movel	%a0,%d1
+	beqs	Lkx_xp_v1
+	movel	%d2,%d1
+	subl	%a0@(4),%d1		| offset in segkmap (below s_base wraps high)
+	cmpl	%a0@(8),%d1
+	bccs	Lkx_xp_v1		| not in segkmap
+	btst	&12,%d1
+	bnew	Lkx_nox			| second page of its slot: the next page is another slot's
+Lkx_xp_v1:
 	movel	%d0,%sp@-		| v1 tier: preserve the return value, discard the far one
 	bsrw	Lkx_farfault
 	movel	%sp@+,%d0
