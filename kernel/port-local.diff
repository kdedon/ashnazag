diff --git a/src/patch_profclk.py b/src/patch_profclk.py
new file mode 100644
index 0000000..f935c39
--- /dev/null
+++ b/src/patch_profclk.py
@@ -0,0 +1,29 @@
+# addupc_clk runs inside the clock interrupt and calls preempt() when runrun
+# is set.  The interrupt path keeps no USP slot that the switch restores, so
+# the process resumes on whatever USP the last process left: profil(2)
+# programs die with garbage PCs.  Skip the call; intret preempts on the way
+# back to user mode through the trap path, which saves and restores USP.
+import sys
+
+IMG = sys.argv[1] if len(sys.argv) > 1 else "build/unix-040"
+TEXT_OFF = 0x34
+SITE = 0x5A052
+OLD = bytes.fromhex("4ab9000000006700")     # tstl runrun; beqw
+NEW = bytes.fromhex("4ab9000000006000")     # tstl runrun; braw
+
+
+def main():
+    buf = bytearray(open(IMG, "rb").read())
+    cur = bytes(buf[TEXT_OFF + SITE:TEXT_OFF + SITE + 8])
+    if cur == NEW:
+        print("  [skip] addupc_clk preempt already skipped @0x%05x" % SITE)
+        return
+    if cur != OLD:
+        raise SystemExit("ABORT: addupc_clk @0x%05x has %s, expected %s (base drifted?)"
+                         % (SITE, cur.hex(), OLD.hex()))
+    buf[TEXT_OFF + SITE:TEXT_OFF + SITE + 8] = NEW
+    open(IMG, "wb").write(buf)
+    print("  [ok]   addupc_clk @0x%05x: preempt left to intret" % SITE)
+
+
+main()
