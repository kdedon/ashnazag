# Interfaces beyond loopback: DHCP when the sdhcp package is installed, else
# (or with no lease in 30 s) QEMU user networking; on real hardware without
# DHCP set your own address, netmask and gateway.
if [ -x /opt/amix/bin/sdhcp ] && /opt/amix/bin/sdhcp -t 30 aen0; then :
else
	{ /usr/sbin/ifconfig aen0 > /dev/null 2>&1 || /usr/sbin/slink addaen /dev/aen0 aen0; } &&
	/usr/sbin/ifconfig aen0 10.0.2.15 netmask 255.255.255.0 up -trailers &&
	/usr/sbin/route add default 10.0.2.2 1 >/dev/null
fi
