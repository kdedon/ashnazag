# cas/cas2 on the 68060: the integer package's page lock faults the operand in
diff --git a/src/isp060_glue.s b/src/isp060_glue.s
index 7db4fc9..ce727dd 100644
--- a/src/isp060_glue.s
+++ b/src/isp060_glue.s
@@ -18,11 +18,9 @@
 | through Lci_done, which rebuilds the ureturn state for a user frame as Lco_done does.
 |
 | CAS/CAS2.  The package emulates both itself once the OS has "locked" the operand pages; its
-| locked sequence uses moves under masked interrupts and cannot take a page fault.  AMIX gives
-| this glue no way to pin a user page here, so Lci_lock REFUSES: the package then terminates the
-| instruction through its own access-error exit, and the process gets the access-fault signal
-| instead of today's death at nullvect.  No installed binary uses cas2 or a misaligned cas
-| (test-tools/scan060.py census); a real lock (as_fault F_SOFTLOCK) is follow-up work.
+| locked sequence uses moves under masked interrupts and cannot take a page fault.  Lci_lock
+| faults the operand in for writing by reading it and writing it back; a single CPU keeps it
+| resident until the sequence ends.  A fault there terminates the instruction with the FSLW.
 |
 | Assembled by m68k-linux-gnu-gcc (GNU syntax, `#` immediates), like fpsp060_glue.s.
 
@@ -109,10 +107,35 @@ Lci_cas2:
 	addql	#1,i60_cas2_n
 	bral	isp060_top+128+0x10	| _060_isp_cas2
 
-| ---- page lock/unlock: refused, see the header ----
+| ---- page lock: fault the operand in, read then write ----
 Lci_lock:
 	addql	#1,i60_lockref_n
-	moveq	#-1,%d0			| nonzero = failure: the package terminates the instruction
+	moveq	#2,%d0
+	tstb	%d1
+	beqs	1f
+	moveq	#4,%d0
+1:	subql	#4,%sp			| operand copy
+	movel	%a0,%sp@-
+	movel	%d0,%sp@-
+	movel	%d0,%sp@-
+	pea	%sp@(12)
+	movel	%a0,%sp@-
+	jsr	copyin
+	lea	%sp@(12),%sp
+	movel	#0x01010001,%d1		| read, long, data
+	tstl	%d0
+	bnes	2f
+	movel	%sp@,%sp@-
+	movel	%sp@(8),%sp@-
+	pea	%sp@(16)
+	jsr	copyout
+	lea	%sp@(12),%sp
+	movel	#0x00810001,%d1		| write, long, data
+2:	tstl	%d0
+	beqs	3f
+	movel	%d1,%d0
+3:	moveal	%sp@(4),%a0
+	lea	%sp@(12),%sp
 	rts
 Lci_unlock:
 	moveq	#0,%d0
@@ -381,7 +404,7 @@ i60_cas2_n:
 	.long	0
 	.globl	i60_lockref_n
 i60_lockref_n:
-	.long	0			| page locks refused (cas/cas2 terminated)
+	.long	0			| page locks taken
 	.globl	i60_mem_n
 i60_mem_n:
 	.long	0			| memory call-outs taken
