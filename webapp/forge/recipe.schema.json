{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdedon.github.io/ashnazag/schemas/forge-recipe.schema.json",
  "type": "object",
  "properties": {
    "formatVersion": {"const": 1},
    "forgeVersion": {"type": "string", "pattern": "^[0-9A-Za-z.-]{1,32}$"},
    "preset": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "revision": {"type": "integer", "minimum": 1}
      },
      "required": ["id", "revision"],
      "additionalProperties": false
    },
    "changes": {
      "type": "object",
      "properties": {
        "devices": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "rootMiB": {"type": "integer", "minimum": 64, "maximum": 2048},
        "swapMiB": {"type": "integer", "minimum": 4, "maximum": 2048},
        "provision": {"type": "array", "items": {"$ref": "#/$defs/package"}}
      },
      "additionalProperties": false
    },
    "lock": {"description": "Validated against lock.schema.json."},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}}
  },
  "required": ["formatVersion", "forgeVersion", "preset", "changes", "lock", "inputs"],
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "package": {
      "type": "object",
      "properties": {
        "kind": {"enum": ["template", "app"]},
        "family": {"enum": ["mac", "tos", "amiga"]},
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"}
      },
      "required": ["kind", "family", "id"],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "role": {"type": "string", "pattern": "^[a-z0-9-]+(:[A-Za-z0-9_.-]{1,64})?$"},
        "size": {"type": "integer", "minimum": 1, "maximum": 8589934592},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "required": ["role", "size", "sha256"],
      "additionalProperties": false
    }
  }
}
